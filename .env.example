# Neon: DATABASE_URL = the POOLED connection string (host contains -pooler). Keep scale-to-zero off in prod.
# DATABASE_URL_DIRECT = the same database WITHOUT the pooler: used by migrations and the worker.
DATABASE_URL_DIRECT=
DATABASE_URL=
# Auth: generate with `openssl rand -base64 32`. Required in production (build fails without it, by design).
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
# E-sign provider webhook (HMAC-SHA256 of the raw body in the x-signature header). Unset = webhook rejects everything.
ESIGN_WEBHOOK_SECRET=change-me
# Payout status webhook, same HMAC scheme.
PAYMENTS_WEBHOOK_SECRET=change-me
# NACH auto-debit: bank answers about mandates and debits (POST /api/webhooks/mandates), same HMAC scheme.
MANDATE_WEBHOOK_SECRET=change-me
# SMS/email delivery-receipt webhook, same HMAC scheme.
NOTIFY_WEBHOOK_SECRET=change-me
# Mandatory grievance-officer disclosure, shown on /grievance. The page warns in production if any are unset.
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_PHONE=
GRIEVANCE_OFFICER_ADDRESS=
# Document storage (invoices, agreements, company pictures). Vercel Blob, private store. Create one in the Vercel dashboard
# (Storage > Blob) and connect it to the project: BLOB_READ_WRITE_TOKEN is then added automatically.
# Leave it unset locally: files go to .data/vault. In production a missing token is an error.
BLOB_READ_WRITE_TOKEN=
# Business settings (optional). Platform balance sheet available for financing, in paise; reconciliation gate on/off.
PLATFORM_CAPITAL_PAISE=
RECON_GATE=on
# Real email delivery through Resend. Without both, messages are simulated (nothing is sent). MAIL_FROM must be on a domain verified in Resend,
# e.g. MAIL_FROM="Marichi <no-reply@yourdomain.com>". SMS stays simulated until an SMS provider and DLT registration exist.
RESEND_API_KEY=
MAIL_FROM=
# Invoice reading (OCR) uses Claude. With a key it reads uploaded invoices to pre-fill the form; without one it is simulated.
ANTHROPIC_API_KEY=
# OCR_MODEL=claude-opus-5-5
# Integrations: "mock" until licences/credentials exist (PRD Section 12)
INTEGRATIONS_MODE=mock
# Encryption key for PAN and bank account numbers (AES-256-GCM): openssl rand -base64 32
# REQUIRED in production. Losing it makes those fields unreadable, so store a copy in your password manager.
# To rotate: set the new value here and move the previous one to DATA_ENCRYPTION_KEY_OLD.
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_OLD=
